# Copy thành .env rồi điền giá trị thật. KHÔNG commit file .env

# --- Phần A, B ---
MONGODB_URI=
PORT=3000
# Nếu để trống, auth dùng giá trị mặc định 'secret' (không an toàn khi triển khai thật)
JWT_SECRET=

# --- Phần D: email (Gmail: dùng mật khẩu ứng dụng 16 ký tự) ---
APP_NAME=Task Manager
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_MAX_ATTEMPTS=3
REMINDER_HOURS=24
REMINDER_CRON=*/10 * * * *
